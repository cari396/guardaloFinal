# Renombrar este archivo a .env al subirlo al servidor de Hostinger

APP_NAME="Guardalo.com"
APP_ENV=production
APP_KEY=base64:OTEujkEEPj7J5TSbMKn+gcyp1QkGswIY30ZozK/JiQk=
APP_DEBUG=false
APP_URL=https://back.guardalo.com.ar

LOG_CHANNEL=daily
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (HOSTINGER)
# ------------------------------------------------------------------------------
# Si usás Hosting Compartido / Cloud de Hostinger (MySQL nativo en hPanel):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u903112704_guardalo
DB_USERNAME=u903112704_guardalo
DB_PASSWORD="3Y|vPv~b"

# Si usás un VPS con PostgreSQL:
