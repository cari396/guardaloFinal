# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=guardalo_db
# DB_USERNAME=postgres
# DB_PASSWORD=TuPasswordPostgres

# ------------------------------------------------------------------------------
# 2. SERVICIO DE CORREO SMTP (HOSTINGER MAIL / TITAN EMAIL)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=contacto@guardalo.com.ar
MAIL_PASSWORD=TuPasswordDelMailDeHostinger
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=contacto@guardalo.com.ar
MAIL_FROM_NAME="Guardalo.com"

# Nota: Si tu servicio de mail contratado en Hostinger es Titan Email, cambiar:
# MAIL_HOST=smtp.titan.email

# ------------------------------------------------------------------------------
# 3. SEGURIDAD, SESIONES Y CORS (SANCTUM)
# ------------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Dominios autorizados para enviar cookies y tokens de sesión
SANCTUM_STATEFUL_DOMAINS=guardalo.com.ar,www.guardalo.com.ar,back.guardalo.com.ar
SESSION_DOMAIN=.guardalo.com.ar

# ------------------------------------------------------------------------------
# 4. MERCADO PAGO Y PASARELA DE PAGOS
# ------------------------------------------------------------------------------
# Obtené tus credenciales desde https://www.mercadopago.com.ar/developers/panel
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SANDBOX=false

# ------------------------------------------------------------------------------
# 5. DATOS BANCARIOS (TRANSFERENCIA DIRECTA)
